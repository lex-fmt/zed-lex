#!/usr/bin/env bash
set -euo pipefail

# Zed extensions are cdylib crates compiled to wasm32-wasip2 — there's
# no host target for `cargo test` to run against, and wasm tests don't
# execute on a developer machine without a wasm runtime. The canonical
# test surface for an extension is its grammar manifest + tree-sitter
# queries, exercised via bats.
#
# Discovery order:
#   1. ./scripts/check-tests        consumer override (full control)
#   2. bats ./test/                  zed-lex convention: manifest +
#                                   queries .bats live at test/*.bats
#   3. bats ./tests/                 alternate plural form
#
# Missing all of the above: exit 0 with a notice. Repos still
# scaffolding tests should not fail the umbrella `bin/check`.
#
# `"$@"` forwards extra args to bats so the script can be invoked like:
#   bin/check-tests --filter manifest

echo "Running tests..."

if [ -x scripts/check-tests ]; then
    echo "Running tests via scripts/check-tests (consumer override)..."
    exec scripts/check-tests "$@"
fi

require_bats() {
    if ! command -v bats >/dev/null 2>&1; then
        echo "::error::bats not installed. Run \`brew install bats-core\` to enable extension tests." >&2
        exit 1
    fi
}

# Enumerate individual .bats files instead of passing the directory to
# bats. Directory mode in bats 1.10 has a tmpdir race when tests run in
# parallel; listing files explicitly avoids the issue.
run_bats_files() {
    local dir="$1"
    shift
    require_bats
    local files=()
    while IFS= read -r -d '' f; do
        files+=("$f")
    done < <(find "$dir" -maxdepth 2 -name '*.bats' -print0 | sort -z)
    if [ ${#files[@]} -eq 0 ]; then
        return 1
    fi
    echo "Running bats on ${#files[@]} file(s) from $dir/ ..."
    bats "${files[@]}" "$@"
}

if run_bats_files test "$@"; then
    echo "Tests OK"
elif run_bats_files tests "$@"; then
    echo "Tests OK"
else
    echo "No .bats tests under test/ or tests/ — skipping."
fi
